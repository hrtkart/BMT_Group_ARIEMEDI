<?xml version="1.0" encoding="utf-8"?>
<robot name="popeye">
  <!-- KDL requires an inertia-free root. The physical torso is rigidly fixed
       to this world frame and is the RViz fixed frame. -->
  <link name="world_link"/>
  <joint name="world_to_torso" type="fixed">
    <parent link="world_link"/>
    <child link="torso_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <link name="torso_link">
    <inertial>
      <origin xyz="-8.3623E-06 0.54848 -0.0018597" rpy="0 0 0" />
      <mass value="2.2493" />
      <inertia ixx="0.10712" ixy="6.4692E-06" ixz="5.4129E-07" iyy="0.013679" iyz="-2.9454E-07" izz="0.11428" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://popeye_description/meshes/collision/torso_link_v3.stl" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://popeye_description/meshes/collision/torso_link_v3.stl" />
      </geometry>
    </collision>
  </link>
 
  <!-- Right Arm -->
  <joint name="R_mounting" type="fixed">
    <!-- Updated from dual_base_left_to_right_v2.json so RViz and
         collision_ur use the same measured dual-base transform. -->
    <origin xyz="-0.00866686 -0.20891779 0.62101372"
            rpy="-3.14085752 0.71697598 1.54323867" />
    <parent link="torso_link" />
    <child link="R_base_link" />
  </joint>

  <link name="R_base_link"/>

  <!-- ROS-Industrial 'base' frame: base_link to UR 'Base' Coordinates transform -->
  <joint name="R_base_link-base_fixed_joint" type="fixed">
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="R_base_link"/>
    <child link="R_base_link_inertia"/>
  </joint>

  <link name="R_base_link_inertia">
    <visual>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://popeye_description/meshes/visual/base.dae"/>
      </geometry>
      <material name="LightGrey">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://popeye_description/meshes/collision/base.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00443333156" ixy="0.0" ixz="0.0" iyy="0.00443333156" iyz="0.0" izz="0.0072"/>
    </inertial>
  </link>

  <!-- RTDE controller base frame used by collision_ur. -->
  <link name="right_base"/>
  <joint name="R_controller_base" type="fixed">
    <parent link="R_base_link_inertia"/>
    <child link="right_base"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <joint name="R_Base" type="revolute">
    <parent link="R_base_link_inertia"/>
    <child link="R_shoulder_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1625"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <link name="R_shoulder_link">
