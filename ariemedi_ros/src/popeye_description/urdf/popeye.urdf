  <!-- Left Arm -->
  <joint name="L_mounting" type="fixed">
    <!-- <origin xyz="0.20731 0 0.72769" rpy="0 2.35619 -1.5707963267949" /> -->
    <origin xyz="0 0.207315 0.63469" rpy="-3.1415927 -0.7853981 1.5707963" />
    <parent link="torso_link"/>
    <child link="L_base_link"/>
  </joint>

  <link name="L_base_link"/>
  <!-- ROS-Industrial 'base' frame: base_link to UR 'Base' Coordinates transform -->
  <joint name="L_base_link-base_link_inertia" type="fixed">
    <parent link="L_base_link"/>
    <child link="L_base_link_inertia"/>
    <!-- 'base_link' is REP-103 aligned (so X+ forward), while the internal
           frames of the robot/controller have X+ pointing backwards.
           Use the joint between 'base_link' and 'base_link_inertia' (a dummy
           link/frame) to introduce the necessary rotation over Z (of pi rad).
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>

  <link name="L_base_link_inertia">
    <visual>
